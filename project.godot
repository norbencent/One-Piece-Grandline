; Engine configuration file.
; Neon Tides: Pirate Legacy — Godot 4.3+ (GL Compatibility renderer for broad Android support)

config_version=5

[application]

config/name="Neon Tides: Pirate Legacy"
config/description="Offline retro-futuristic pixel-art pirate action RPG for Android."
config/version="0.1.0"
run/main_scene="res://scenes/main/SplashScreen.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.0235294, 0.0392157, 0.0941176, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/managers/event_bus.gd"
Settings="*res://scripts/managers/settings_manager.gd"
AudioManager="*res://scripts/managers/audio_manager.gd"
DataRegistry="*res://scripts/managers/data_registry.gd"
SaveManager="*res://scripts/save_system/save_manager.gd"
GameManager="*res://scripts/managers/game_manager.gd"
SceneManager="*res://scripts/managers/scene_manager.gd"
InputConfig="*res://scripts/managers/input_config.gd"
Platform="*res://scripts/android/platform_bridge.gd"

[debug]

gdscript/warnings/unused_signal=0

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0.0235294, 0.0392157, 0.0941176, 1)
